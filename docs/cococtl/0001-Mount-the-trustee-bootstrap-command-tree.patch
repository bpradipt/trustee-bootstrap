From 574ff21a69052297c18ad767d5dbe0f406c6fc8e Mon Sep 17 00:00:00 2001
From: Pradipta Banerjee <pradipta.banerjee@gmail.com>
Date: Wed, 11 Nov 2026 13:08:48 +0530
Subject: [PATCH] Mount the trustee-bootstrap command tree

Security Operators unlock a Trustee running in a confidential VM with
K-of-N Shares, using the trustee-bootstrap command tree. Mount that
tree under `cococtl trustee-bootstrap` (and `kubectl coco
trustee-bootstrap`) so they use the tool they already have. The tree
and its security review stay in
github.com/confidential-devhub/trustee-bootstrap; cococtl only adds it
to the root command.

Building the tree opens no connections, starts no programs and looks
nothing up on PATH. Startup gains one file read: BurntSushi/toml's
package init reads /etc/localtime for the local UTC offset, and Go
falls back to UTC when the file is missing.

The replace directive points at a sibling checkout for testing.
Replace it with a tagged trustee-bootstrap release before merging.

Signed-off-by: Pradipta Banerjee <pradipta.banerjee@gmail.com>
---
 cmd/root.go |  4 +++
 go.mod      | 40 ++++++++++++++--------
 go.sum      | 95 ++++++++++++++++++++++++++++-------------------------
 3 files changed, 81 insertions(+), 58 deletions(-)

diff --git a/cmd/root.go b/cmd/root.go
index 2bec3f2..6c4481d 100644
--- a/cmd/root.go
+++ b/cmd/root.go
@@ -12,6 +12,7 @@ import (
 
 	"github.com/confidential-devhub/cococtl/cmd/initdata"
 	"github.com/confidential-devhub/cococtl/cmd/kbs"
+	trusteebootstrap "github.com/confidential-devhub/trustee-bootstrap/pkg/cli"
 )
 
 // version is set at build time via ldflags
@@ -47,6 +48,9 @@ func init() {
 	cobra.OnInitialize()
 	rootCmd.AddCommand(kbs.KbsCmd)
 	rootCmd.AddCommand(initdata.InitdataCmd)
+	// Trustee bootstrap: K-of-N unlock of Trustee in a CVM. The command
+	// tree and its review live in confidential-devhub/trustee-bootstrap.
+	rootCmd.AddCommand(trusteebootstrap.NewTrusteeBootstrapCmd())
 }
 
 // contextKey is the type for context keys used in cococtl
