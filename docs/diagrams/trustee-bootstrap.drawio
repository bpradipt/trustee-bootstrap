<mxfile host="drawio">
  <diagram id="unlock" name="Unlock Ceremony">
    <mxGraphModel adaptiveColors="auto" dx="1400" dy="800" grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="700">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Unlock Ceremony&lt;/b&gt; (one Security Operator; repeat until K Shares are accepted, one relay at a time)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ws" value="&lt;b&gt;Security Operator workstation&lt;/b&gt; (Linux / WSL)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="380" height="530" as="geometry"/>
        </mxCell>
        <mxCell id="cli" value="&lt;b&gt;trustee-bootstrap approve&lt;/b&gt;&lt;br&gt;(cococtl or standalone)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="340" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ov" value="&lt;b&gt;Operator Verifier&lt;/b&gt;&lt;br&gt;stock Trustee KBS + AS&lt;br&gt;listens on 127.0.0.1 only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="pol" value="&lt;b&gt;Operator Policy&lt;/b&gt;&lt;br&gt;+ own Share file" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="260" width="110" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="appraise" value="&lt;b&gt;5&lt;/b&gt; Appraise evidence against the Operator Policy:&lt;br&gt;TEE type, reference values, Init-Data digest, debug off.&lt;br&gt;Only then release JWE{index, share, bundle_sha256}&lt;br&gt;to the attested tee-pubkey." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="355" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="coll" value="Intel PCS / PCCS, AMD KDS&lt;br&gt;or offline collateral (outbound)" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="infra" value="&lt;b&gt;Untrusted&lt;/b&gt;&lt;br&gt;Kubernetes, host, network" style="rounded=1;arcSize=3;dashed=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="430" y="70" width="200" height="530" as="geometry"/>
        </mxCell>
        <mxCell id="svc" value="NodePort, LoadBalancer&lt;br&gt;or Ingress&lt;br&gt;(plain HTTP is fine)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="190" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cms" value="&lt;b&gt;ConfigMaps&lt;/b&gt;&lt;br&gt;ceremony.json&lt;br&gt;Sealed Bundle" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="320" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cvm" value="&lt;b&gt;Trustee CVM&lt;/b&gt; (one CoCo pod)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="660" y="70" width="430" height="530" as="geometry"/>
        </mxCell>
        <mxCell id="initdata" value="&lt;b&gt;Init-Data&lt;/b&gt; (digest in TEE evidence): agent policy pins images and&lt;br&gt;helper args incl. --manifest-sha256; AA/CDH KBS URL = guest proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="675" y="100" width="400" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="bh" value="&lt;b&gt;Bootstrap Helper&lt;/b&gt; (init container)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="675" y="160" width="250" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="relay" value="relay server&lt;br&gt;GET /bootstrap/v1/relay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="190" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="proxy" value="guest proxy 127.0.0.1:&amp;lt;proxy port&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="250" width="220" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="checks" value="manifest digest = arg; per Share:&lt;br&gt;commitment, new index, bundle digest.&lt;br&gt;At K: Shamir combine, age unseal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="310" width="220" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="cdh" value="&lt;b&gt;CDH / AA&lt;/b&gt;&lt;br&gt;(stock CoCo)&lt;br&gt;RCAR client,&lt;br&gt;holds TEE key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="950" y="235" width="125" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="tmpfs" value="state volume (guest tmpfs)&lt;br&gt;emptyDir, medium: Memory" style="shape=cylinder3;boundedLbl=1;size=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="675" y="430" width="250" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="trustee" value="&lt;b&gt;Trustee&lt;/b&gt; (main container, unmodified)&lt;br&gt;holds Trustee TLS key from the bundle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="675" y="510" width="250" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="wl" value="&lt;b&gt;Confidential workloads&lt;/b&gt;&lt;br&gt;carry Trustee cert&lt;br&gt;in their Init-Data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="505" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="Solid arrows: steps in order. Dashed: the RCAR byte stream (guest proxy to relay to CLI to Operator Verifier), never parsed in between. No listener on the operator machine is reachable from outside." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="620" width="1260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="1 start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cli" target="ov">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="140" y="220"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e1b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="pol" target="cli">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="2 open relay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cli" target="svc">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-12"/>
            <Array as="points">
              <mxPoint x="530" y="150"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e2b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="svc" target="relay">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="3 GET Share" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="relay" target="cdh">
          <mxGeometry x="0.5" relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-14"/>
            <Array as="points">
              <mxPoint x="1012" y="210"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="4 RCAR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cdh" target="proxy">
          <mxGeometry x="0.9" relative="1" as="geometry">
            <mxPoint as="offset" x="-30" y="26"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4b" value="" style="html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="proxy" target="relay">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4c" value="4 RCAR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;dashed=1;labelBackgroundColor=#ffffff;exitX=0.0588;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli" target="ov">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ov" target="coll">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="6 decrypted&lt;br&gt;payload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cdh" target="checks">
          <mxGeometry x="0.3" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1012" y="352"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e0" value="read, checked&lt;br&gt;by digest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cms" target="checks">
          <mxGeometry x="-1" relative="1" as="geometry">
            <mxPoint as="offset" x="-80" y="58"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="7 at K Shares: publish atomically" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="checks" target="tmpfs">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="8"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="8 sealed config and state" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tmpfs" target="trustee">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="9 Workload&lt;br&gt;Attestation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;startArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="trustee" target="wl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="setup" name="Setup">
    <mxGraphModel adaptiveColors="auto" dx="1400" dy="800" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="520">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s-title" value="&lt;b&gt;Setup&lt;/b&gt; (Key Ceremony once; sealing and policy build per config change)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="800" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ca" value="&lt;b&gt;Ceremony Authority&lt;/b&gt;&lt;br&gt;air-gapped&lt;br&gt;ceremony split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="shares" value="&lt;b&gt;Share files&lt;/b&gt;&lt;br&gt;one per Security Operator" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="70" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="man" value="&lt;b&gt;Ceremony Manifest&lt;/b&gt;&lt;br&gt;threshold, Share Commitments,&lt;br&gt;age recipient" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="150" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="plain" value="Trustee config tree&lt;br&gt;incl. Trustee TLS key&lt;br&gt;(plaintext)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="io" value="&lt;b&gt;Infrastructure Operator&lt;/b&gt;&lt;br&gt;seal (age + tar)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="250" y="300" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sb" value="&lt;b&gt;Sealed Bundle&lt;/b&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="305" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="id" value="&lt;b&gt;Init-Data&lt;/b&gt; (reviewed)&lt;br&gt;pins images and helper args&lt;br&gt;incl. --manifest-sha256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="150" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="so" value="&lt;b&gt;Security Operator&lt;/b&gt;&lt;br&gt;policy build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="740" y="60" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="op" value="&lt;b&gt;Operator Policy&lt;/b&gt;&lt;br&gt;TEE types, reference values,&lt;br&gt;Init-Data digest (computed locally),&lt;br&gt;Approved Bundle digest" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="150" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cm" value="&lt;b&gt;Kubernetes&lt;/b&gt; (untrusted)&lt;br&gt;pod + ConfigMaps" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="290" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s-note" value="The bootstrap private key never exists after the Key Ceremony, except transiently inside the Trustee CVM during unseal." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="420" width="920" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="split" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ca" target="shares">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ca" target="man">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="out-of-band" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="shares" target="so">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="recipient" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="man" target="io">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="plain" target="io">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="io" target="sb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="sha256" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="man" target="id">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s8" value="digest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="id" target="op">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s9" value="sha256" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sb" target="op">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="330"/>
              <mxPoint x="700" y="210"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s10" value="" style="html=1;endArrow=block;" edge="1" parent="1" source="so" target="op">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s11" value="deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sb" target="cm">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="565" y="390"/>
              <mxPoint x="840" y="390"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="components" name="Components"><mxGraphModel adaptiveColors="auto" dx="1400" dy="830" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="830"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c-title" value="&lt;b&gt;Components&lt;/b&gt;: what runs where, in what form, and who builds it" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c-offline" value="&lt;b&gt;Offline machines&lt;/b&gt; (trusted for one step each)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="420" height="180" as="geometry"/></mxCell><mxCell id="c-split" value="&lt;b&gt;trustee-bootstrap ceremony split&lt;/b&gt;&lt;br&gt;&lt;i&gt;process&lt;/i&gt;&lt;br&gt;Ceremony Authority, air-gapped. Writes ceremony.json and one Share file per Security Operator, handed over in person" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="185" height="125" as="geometry"/></mxCell><mxCell id="c-seal" value="&lt;b&gt;trustee-bootstrap seal&lt;/b&gt;&lt;br&gt;&lt;i&gt;process&lt;/i&gt;&lt;br&gt;Infrastructure Operator, sealing machine. Checks Trustee&#x27;s config and encrypts it into bundle.age" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="240" y="95" width="185" height="125" as="geometry"/></mxCell><mxCell id="c-ws" value="&lt;b&gt;Security Operator workstation&lt;/b&gt; (trusted, Linux or WSL)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="265" width="420" height="320" as="geometry"/></mxCell><mxCell id="c-cli" value="&lt;b&gt;trustee-bootstrap policy build, approve&lt;/b&gt;&lt;br&gt;&lt;i&gt;process&lt;/i&gt;, from cococtl or the standalone binary. approve opens the relay outbound and passes RCAR bytes to the Operator Verifier" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="380" height="65" as="geometry"/></mxCell><mxCell id="c-ov" value="&lt;b&gt;Operator Verifier&lt;/b&gt;: KBS + built-in AS&lt;br&gt;&lt;i&gt;container&lt;/i&gt; (podman or docker) from the pinned upstream image, or a native kbs&lt;br&gt;listens on 127.0.0.1 only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="185" height="120" as="geometry"/></mxCell><mxCell id="c-run" value="&lt;b&gt;Run directory&lt;/b&gt; on tmpfs, mounted at /etc/kbs: kbs.toml, reference values, resource policy, Share payload. Wiped when approve exits" style="shape=note;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="240" y="390" width="180" height="120" as="geometry"/></mxCell><mxCell id="c-pol" value="&lt;b&gt;Operator Policy&lt;/b&gt; (from policy build) and the operator&#x27;s own Share file" style="shape=note;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="525" width="380" height="50" as="geometry"/></mxCell><mxCell id="c-node" value="&lt;b&gt;Kubernetes node&lt;/b&gt; (untrusted: host, kubelet, network, storage)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;dashed=1;fillColor=#f5f5f5;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="460" y="60" width="920" height="640" as="geometry"/></mxCell><mxCell id="c-kubelet" value="&lt;b&gt;kubelet&lt;/b&gt;&lt;br&gt;&lt;i&gt;host process&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="480" y="95" width="120" height="65" as="geometry"/></mxCell><mxCell id="c-shim" value="&lt;b&gt;containerd + Kata shim&lt;/b&gt;&lt;br&gt;&lt;i&gt;host processes&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="625" y="95" width="170" height="65" as="geometry"/></mxCell><mxCell id="c-qemu" value="&lt;b&gt;QEMU&lt;/b&gt;&lt;br&gt;&lt;i&gt;host process&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="820" y="95" width="160" height="65" as="geometry"/></mxCell><mxCell id="c-swtpm" value="&lt;b&gt;swtpm&lt;/b&gt; (test only)&lt;br&gt;&lt;i&gt;host process&lt;/i&gt;: the VM&#x27;s TPM. Real TDX or SNP hardware replaces it" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1005" y="95" width="165" height="65" as="geometry"/></mxCell><mxCell id="c-pull" value="&lt;i&gt;Each guest pulls and unpacks its own container images; the host never holds them unpacked.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="95" width="175" height="70" as="geometry"/></mxCell><mxCell id="c-svch" value="&lt;b&gt;Service&lt;/b&gt; trustee-bootstrap-helper&lt;br&gt;NodePort, publishNotReadyAddresses. The relay from approve lands here" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="150" height="95" as="geometry"/></mxCell><mxCell id="c-cms" value="&lt;b&gt;ConfigMaps&lt;/b&gt; (untrusted)&lt;br&gt;ceremony.json, bundle.age&lt;br&gt;mounted read-only" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="420" width="150" height="85" as="geometry"/></mxCell><mxCell id="c-cvm" value="&lt;b&gt;Trustee CVM&lt;/b&gt;: one Kata pod in its own VM (TEE boundary)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="650" y="200" width="450" height="480" as="geometry"/></mxCell><mxCell id="c-init" value="&lt;b&gt;Init-Data&lt;/b&gt;, measured into the TEE evidence: the agent policy (pins both images and the helper&#x27;s args), aa.toml, cdh.toml" style="shape=note;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="670" y="235" width="410" height="45" as="geometry"/></mxCell><mxCell id="c-aa" value="&lt;b&gt;AA + CDH&lt;/b&gt;&lt;br&gt;&lt;i&gt;guest processes&lt;/i&gt; (guest-components): TEE evidence, TEE key, RCAR client" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="670" y="290" width="200" height="70" as="geometry"/></mxCell><mxCell id="c-agent" value="&lt;b&gt;kata-agent&lt;/b&gt;&lt;br&gt;&lt;i&gt;guest process&lt;/i&gt;: enforces the agent policy. No exec, no log reads" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="880" y="290" width="200" height="70" as="geometry"/></mxCell><mxCell id="c-helper" value="&lt;b&gt;bootstrap-helper&lt;/b&gt;&lt;br&gt;&lt;i&gt;init container&lt;/i&gt;, image built from this repo&lt;br&gt;relay server :8090, guest proxy 127.0.0.1:8081. Collects K Shares, unseals, exits" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="670" y="400" width="200" height="120" as="geometry"/></mxCell><mxCell id="c-trustee" value="&lt;b&gt;Trustee&lt;/b&gt;: KBS + built-in AS&lt;br&gt;&lt;i&gt;main container&lt;/i&gt;, the same unmodified upstream image as the Operator Verifier. Serves workloads on :8080" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="880" y="400" width="200" height="120" as="geometry"/></mxCell><mxCell id="c-state" value="&lt;b&gt;State volume&lt;/b&gt;: emptyDir medium: Memory, a tmpfs in guest memory. Holds the unsealed config; gone with the VM" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="670" y="560" width="410" height="60" as="geometry"/></mxCell><mxCell id="c-cvmnote" value="&lt;i&gt;On a real TEE the host can&#x27;t read this VM&#x27;s memory. The agent policy blocks exec and log reads.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="630" width="410" height="40" as="geometry"/></mxCell><mxCell id="c-wcvm" value="&lt;b&gt;Workload CVM&lt;/b&gt;: another Kata pod (TEE)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1120" y="200" width="240" height="270" as="geometry"/></mxCell><mxCell id="c-wl" value="&lt;b&gt;workload&lt;/b&gt;&lt;br&gt;&lt;i&gt;container&lt;/i&gt;, your image" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1135" y="235" width="210" height="55" as="geometry"/></mxCell><mxCell id="c-winit" value="&lt;b&gt;Init-Data&lt;/b&gt; carries kbs_cert: Trustee&#x27;s certificate" style="shape=note;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1135" y="300" width="210" height="55" as="geometry"/></mxCell><mxCell id="c-waa" value="&lt;b&gt;kata-agent, AA + CDH&lt;/b&gt;&lt;br&gt;&lt;i&gt;guest processes&lt;/i&gt;. The guest API on 127.0.0.1:8006 gives the workload its secrets" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1135" y="365" width="210" height="90" as="geometry"/></mxCell><mxCell id="c-svct" value="&lt;b&gt;Service&lt;/b&gt; trustee&lt;br&gt;ClusterIP :8080" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1135" y="500" width="210" height="60" as="geometry"/></mxCell><mxCell id="c-legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="420" height="215" as="geometry"/></mxCell><mxCell id="c-sw0" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="34" height="18" as="geometry"/></mxCell><mxCell id="c-swt0" value="built from this repo (Go)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="84" y="630" width="340" height="22" as="geometry"/></mxCell><mxCell id="c-sw1" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="40" y="658" width="34" height="18" as="geometry"/></mxCell><mxCell id="c-swt1" value="upstream Trustee (Rust), unmodified" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="84" y="656" width="340" height="22" as="geometry"/></mxCell><mxCell id="c-sw2" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="684" width="34" height="18" as="geometry"/></mxCell><mxCell id="c-swt2" value="upstream Kata Containers and guest-components" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="84" y="682" width="340" height="22" as="geometry"/></mxCell><mxCell id="c-sw3" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="34" height="18" as="geometry"/></mxCell><mxCell id="c-swt3" value="Kubernetes, the host, or your own" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="84" y="708" width="340" height="22" as="geometry"/></mxCell><mxCell id="c-sw4" value="" style="shape=note;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="736" width="34" height="18" as="geometry"/></mxCell><mxCell id="c-swt4" value="measured config (Init-Data)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="84" y="734" width="340" height="22" as="geometry"/></mxCell><mxCell id="c-legnote" value="Zones: blue is a trusted machine, green is inside a TEE, dashed red is untrusted. Each box names its form: &lt;i&gt;process&lt;/i&gt;, &lt;i&gt;container&lt;/i&gt; or &lt;i&gt;guest process&lt;/i&gt;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="765" width="390" height="45" as="geometry"/></mxCell><mxCell id="c-e1" value="starts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.24;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c-cli" target="c-ov"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.342;" edge="1" parent="1" source="c-cli" target="c-svch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-e3" value=":8090" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="c-svch" target="c-helper"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="c-cms" target="c-helper"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-e5" value="RCAR via guest proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;dashed=1;startArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c-aa" target="c-helper"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-e6" value="unsealed tree" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.24;entryY=0;" edge="1" parent="1" source="c-helper" target="c-state"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-e7" value="config" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c-state" target="c-trustee"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c-seal" target="c-cms"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="157"/><mxPoint x="450" y="462"/></Array></mxGeometry></mxCell><mxCell id="c-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c-kubelet" target="c-shim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c-shim" target="c-qemu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c-swtpm" target="c-qemu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-e12" value="one VM per pod" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.55;entryY=0;" edge="1" parent="1" source="c-qemu" target="c-cvm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c-qemu" target="c-wcvm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="182"/><mxPoint x="1240" y="182"/></Array></mxGeometry></mxCell><mxCell id="c-e14" value="Workload Attestation: HTTPS, pinned to kbs_cert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c-waa" target="c-svct"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c-svct" target="c-trustee"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="530"/><mxPoint x="1110" y="460"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram>
</mxfile>
