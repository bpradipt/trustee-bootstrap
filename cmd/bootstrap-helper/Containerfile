# The Bootstrap Helper image. Build it from the repo root:
#
#   podman build --timestamp 0 --identity-label=false \
#     -f cmd/bootstrap-helper/Containerfile -t bootstrap-helper .
#
# --timestamp 0 and --identity-label=false make the image reproducible: two
# builds of the same source give the same digest.
FROM docker.io/library/golang:1.26.4-alpine@sha256:3ad57304ad93bbec8548a0437ad9e06a455660655d9af011d58b993f6f615648 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w -buildid=' \
	-o /out/bootstrap-helper ./cmd/bootstrap-helper

FROM scratch
COPY --from=build /out/bootstrap-helper /bootstrap-helper
ENTRYPOINT ["/bootstrap-helper"]
