 */}}
 {{- define "coco-trustee.kbs.useBootstrapKeysJob" -}}
-{{- if .Values.secrets.useEphemeralGeneratedKeys }}1{{- end -}}
+{{- if and .Values.secrets.useEphemeralGeneratedKeys (not .Values.kbs.configFile) }}1{{- end -}}
+{{- end }}
+
+{{/*
+"1" when KBS reads a config file the chart does not render (`kbs.configFile`).
+The chart then renders no KBS ConfigMap and mounts no user-keys Secret, storage
+volume or nebula CA volume.
+*/}}
+{{- define "coco-trustee.kbs.externalConfig" -}}
