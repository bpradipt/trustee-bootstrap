+{{- end }}
+
+{{/*
+"1" when the AS and RVPS run as their own Deployments (`attestationService.mode=grpc`).
+*/}}
+{{- define "coco-trustee.as.grpc" -}}
+{{- $mode := default "grpc" ((.Values.attestationService | default dict).mode) -}}
+{{- if not (has $mode (list "grpc" "builtin")) }}
+{{- fail (printf "attestationService.mode must be grpc or builtin, not %q" $mode) }}
+{{- end }}
+{{- if eq $mode "grpc" }}1{{- end -}}
 {{- end }}
 
